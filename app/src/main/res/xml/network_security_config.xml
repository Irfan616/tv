<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- IPTV streams and self-hosted Xtream servers often use HTTP; users are warned in UI when using HTTP -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
